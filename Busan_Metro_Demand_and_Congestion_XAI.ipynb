        "### 4. 설명가능한 인공지능 (XAI) 정량 분석\n",
        "\n",
        "#### ① Integrated Gradients (IG; Sundararajan 등, 2017)\n",
        "- 기준점 $\\mathbf{x}'=0$ (학습자료 평균 수준)에서 실제 입력 $\\mathbf{x}$까지 직선 경로를 따라 신경망의 기울기(Gradient)를 적분하여 예측 기여도를 산출합니다.\n",
        "\n",
        "$$\\text{IG}_i(\\mathbf{x}) = (x_i - x'_i) \\int_{0}^{1} \\frac{\\partial F(\\mathbf{x}' + \\alpha(\\mathbf{x} - \\mathbf{x}'))}{\\partial x_i} d\\alpha$$\n",
        "\n",
        "#### ② Permutation Importance (PI; Breiman, 2001)\n",
        "- 테스트 데이터에서 변수 $j$를 무작위로 셔플링했을 때 발생하는 RMSE 오차 증가량을 측정합니다.\n",
        "\n",
        "$$\\text{PI}_j = \\text{RMSE}(X^{(j)}) - \\text{RMSE}(X)$$"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ==============================================================================\n",
        "# 5. Integrated Gradients (IG) 알고리즘 구현 및 중요도 시각화\n",
        "# ==============================================================================\n",
        "def compute_integrated_gradients_static(model, seq_sample, static_sample, m_steps=50):\n",
        "    \"\"\"\n",
        "    정적 입력 변수에 대한 Integrated Gradients 산출 함수\n",
        "    \"\"\"\n",
        "    baseline_static = tf.zeros_like(static_sample)\n",
        "    alphas = tf.linspace(0.0, 1.0, m_steps + 1)\n",
        "    \n",
        "    # Alpha 경로 보간\n",
        "    interpolated_static = [baseline_static + alpha * (static_sample - baseline_static) for alpha in alphas]\n",
        "    interpolated_static = tf.concat(interpolated_static, axis=0)\n",
        "    repeated_seq = tf.repeat(seq_sample, repeats=m_steps + 1, axis=0)\n",
        "    \n",
        "    # Gradient 적분\n",
        "    with tf.GradientTape() as tape:\n",
        "        tape.watch(interpolated_static)\n",
        "        predictions = model([repeated_seq, interpolated_static])\n",
        "    \n",
        "    grads = tape.gradient(predictions, interpolated_static)\n",
        "    avg_grads = tf.reduce_mean(grads, axis=0, keepdims=True)\n",
        "    integrated_grads = (static_sample - baseline_static) * avg_grads\n",
        "    return integrated_grads.numpy()\n",
        "\n",
        "# 포스터 연구 결과 수치 시각화\n",
        "ig_data = pd.DataFrame([\n",
        "    ('is_offday', 0.079), ('is_weekend', 0.064), ('dow_cos', 0.051), ('covid', 0.042),\n",
        "    ('prev_log_growth', 0.025), ('holiday', 0.024), ('dow_sin', 0.022), ('board_y1', 0.017),\n",
        "    ('line_2', 0.016), ('is_friday', 0.015), ('trend', 0.015), ('month_sin', 0.014),\n",
        "    ('line_3', 0.014), ('board_y1_roll28', 0.013), ('line_4', 0.013)\n",
        "], columns=['Feature', 'IG']).sort_values('IG', ascending=True)\n",
        "\n",
        "pi_data = pd.DataFrame([\n",
        "    ('is_offday', 19800), ('day_of_week_cycle', 17000), ('is_weekend', 15700),\n",
        "    ('holiday', 7400), ('is_friday', 5400), ('prev_log_growth', 3800),\n",
        "    ('line', 3500), ('board_y1_roll28', 900), ('month_cycle', 400),\n",
        "    ('board_y1', 200), ('after_holiday', 200), ('covid', 50)\n",
        "], columns=['Feature', 'PI']).sort_values('PI', ascending=True)\n",
