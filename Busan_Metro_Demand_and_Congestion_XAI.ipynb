        "### 2. CNN-LSTM 혼잡도 예측 모형 아키텍처 및 평가\n",
        "\n",
        "- **입력**: 날짜(일, 월, 연도), 공휴일 여부, 과거 혼잡도 시계열\n",
        "- **출력**: 일별 혼잡도 지수\n",
        "- **구조**: `1D-Conv` $\\rightarrow$ `MaxPool` $\\rightarrow$ `1D-Conv` $\\rightarrow$ `MaxPool` $\\rightarrow$ `Flatten` $\\rightarrow$ `LSTM` $\\rightarrow$ `Dense` $\\rightarrow$ `Output`\n",
        "- 시계열의 국소적 급변 패턴 추출과 장기 시계열 의존성을 동시에 포착합니다."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# ==============================================================================\n",
        "# 7. CNN-LSTM 혼잡도 시계열 신경망 아키텍처 정의\n",
        "# ==============================================================================\n",
        "def build_cnn_lstm_congestion_model(window_size=30, num_features=5):\n",
        "    inp = Input(shape=(window_size, num_features), name='congestion_seq_in')\n",
        "    \n",
        "    # CNN 계층: 국소적 단기 급변 패턴 추출\n",
        "    x = layers.Conv1D(filters=32, kernel_size=3, padding='same', activation='relu', name='conv1d_1')(inp)\n",
        "    x = layers.MaxPooling1D(pool_size=2, name='maxpool_1')(x)\n",
        "    x = layers.Conv1D(filters=64, kernel_size=3, padding='same', activation='relu', name='conv1d_2')(x)\n",
        "    x = layers.MaxPooling1D(pool_size=2, name='maxpool_2')(x)\n",
        "    x = layers.Flatten(name='cnn_flatten')(x)\n",
        "    \n",
        "    # LSTM 계층 연결: 시계열 장단기 의존성 학습\n",
        "    x = layers.RepeatVector(1)(x)\n",
        "    x = layers.LSTM(64, activation='tanh', return_sequences=False, name='lstm_congestion')(x)\n",
        "    \n",
        "    # Fully-Connected Dense 계층\n",
        "    x = layers.Dense(32, activation='relu', name='dense_congestion_1')(x)\n",
        "    x = layers.Dense(16, activation='relu', name='dense_congestion_2')(x)\n",
        "    out = layers.Dense(1, name='output_congestion_index')(x)\n",
        "    \n",
        "    model = Model(inputs=inp, outputs=out, name='CNN_LSTM_Congestion_Model')\n",
        "    model.compile(optimizer='adam', loss='mse', metrics=['mae'])\n",
        "    return model\n",
        "\n",
        "cnn_lstm_model = build_cnn_lstm_congestion_model(window_size=30, num_features=5)\n",
        "cnn_lstm_model.summary()"
      ]
    },
